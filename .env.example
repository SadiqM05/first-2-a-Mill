# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Required for AI answers. Without them Larry runs in "sources only" mode.
GEMINI_API_KEY=
# A Gemini model your account can use; no default is hardcoded anywhere.
GEMINI_MODEL=

# Optional overrides (defaults shown). Mainly used by tests.
# RESLINK_CATALOG_PATH=data/resources.json
# RESLINK_INDEX_PATH=data/index/chunks.json
# RESLINK_CHROMA_PATH=data/index/chroma
# RESLINK_BULLETIN_PATH=data/bulletins.json
